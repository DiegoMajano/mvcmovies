@model IEnumerable<Pelicula>

@{
    ViewData["Title"] = "Peliculas";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Titulo</th>
            <th>FechaLanzamiento</th>
            <th>Precio</th>
            <th>Director</th>
            <th>Genero</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Titulo</td>
            <td>@item.FechaLanzamiento.ToShortDateString()</td>
            <td>@item.Precio.ToString("C")</td>
            <td>@item.Director</td>
            <td>@item.Genero?.Nombre</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
