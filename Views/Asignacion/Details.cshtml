@model Asignacion

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Asignacion</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Empleado</dt>
        <dd class="col-sm-10">@Model.Empleado?.Nombre @Model.Empleado?.Apellido</dd>
        <dt class="col-sm-2">Proyecto</dt>
        <dd class="col-sm-10">@Model.Proyecto?.Nombre</dd>
        <dt class="col-sm-2">Fecha Asignación</dt>
        <dd class="col-sm-10">@Model.FechaAsignacion.ToShortDateString()</dd>
        <dt class="col-sm-2">Rol</dt>
        <dd class="col-sm-10">@Model.Rol</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-primary">Back to List</a>
</div>
