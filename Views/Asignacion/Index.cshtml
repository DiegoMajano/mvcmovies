@model IEnumerable<Asignacion>

@{
    ViewData["Title"] = "Asignaciones";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Empleado</th>
            <th>Proyecto</th>
            <th>Fecha Asignación</th>
            <th>Rol</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Empleado?.Nombre @item.Empleado?.Apellido</td>
            <td>@item.Proyecto?.Nombre</td>
            <td>@item.FechaAsignacion.ToShortDateString()</td>
            <td>@item.Rol</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
